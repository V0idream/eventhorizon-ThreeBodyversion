    <string name="Quest_ThreeBodyPrologue">三体视界</string>
    <string name="ThreeBodyPrologue_Message1">欢迎游玩《三体视界》，我们已经重构了原版，当然也包括很多新机制。你准备好了吗？——边界工作室</string>
    <string name="ThreeBodyPrologue_Confirm">确认。</string>
    <string name="ThreeBodyPrologue_Message2">自广播纪元来临，无数人都在恐惧那一天的到来，而现在，已经来临，黑暗森林打击来了。\n\n而你，身为星舰地球的一份子，即将使用母舰曲率前往星辰大海，恢复人类的荣光！</string>
    <string name="ThreeBodyPrologue_Advance">前进四。</string>
    <string name="Quest_ThreeBodyJourney">前进四</string>
    <string name="Quest_MothersTears">圣母的眼泪</string>
    <string name="MothersTears_Offer">完成“前进四”后的下一次航线结束时，你收到了一份加密作战提案。点击“接取”进入任务。</string>
    <string name="MothersTears_Accept">接取</string>
    <string name="MothersTears_Advance">继续</string>
    <string name="MothersTears_Stage1Progress">第一阶段：获取SIM样本（已占领 {0}/{1} 个目标三体空间站）</string>
    <string name="MothersTears_Stage2Progress">第二阶段：获取技术资料情报（已占领 {0}/{1} 个目标三体空间站）</string>
    <string name="MothersTears_Stage3Progress">第三阶段：夺取水滴样本（前往标记的三体空间站并击败守军）</string>
    <string name="MothersTears_Stage3Capture">第三阶段：接管目标空间站并回收水滴样本</string>
    <string name="MothersTears_Stage4Progress">第四阶段：最终时刻（前往标记的无主星系并击败三体泰坦）</string>
    <string name="MothersTears_Image01">比起圣母的眼泪，我想，叫它死神的眼泪更贴切。但是，死神不会流泪，直到今天。</string>
    <string name="MothersTears_Image02">就由我们让它流泪！</string>
    <string name="MothersTears_Image03">它们的加密技术宛如神明，我们需要更多情报才能破解技术资料。</string>
    <string name="MothersTears_Image04">但它们也做好了准备，恶战不可避免。</string>
    <string name="MothersTears_Image05">SIM技术已经为我们掌握，但是水滴那违反物理学的推进方式我们至今无法理解。</string>
    <string name="MothersTears_Image06">是我们的主场了！</string>
    <string name="Quest_BeautifulProminence">美丽的日珥</string>
    <string name="BeautifulProminence_Offer">与“圣母的眼泪”同时送达的另一份任务提案。点击“接取”调查那段来自旧时代的异常信号。</string>
    <string name="BeautifulProminence_Accept">接取</string>
    <string name="BeautifulProminence_Advance">继续</string>
    <string name="BeautifulProminence_Stage1Progress">第一阶段：异常信号（前往标记星系的感染行星，摧毁并探索巢穴 {0}/{1}）</string>
    <string name="BeautifulProminence_Stage2Progress">第二阶段：破译2001机密文件（通过正常空间站界面完成任意一次防卫战）</string>
    <string name="BeautifulProminence_Stage3Progress">第三阶段：播放2001机密文件（完成下一次航行后播放）</string>
    <string name="BeautifulProminence_FileExplanation">这艘舰船本应在太阳中燃烧殆尽，但剧烈的太阳活动在产生强电磁脉冲的同时使它偏离了轨道坠落于此。</string>
    <string name="BeautifulProminence_CoincidenceOption">何等的巧合</string>
    <string name="BeautifulProminence_Image01">收到报告，附近的一颗行星有与我们语言相同的信号，疑似是坠毁的舰船，但是我们没有相关记录。</string>
    <string name="BeautifulProminence_Image02">文件经过加密，虽然技术古早，但不依靠空间站的超级电脑也难以完成。</string>
    <string name="BeautifulProminence_Image03">告诉米沙，照他说的去做吧。\n就像一粒沙子掉进眼睛。\n航向校准完毕，引擎加力110%，前进！</string>
    <string name="BeautifulProminence_Image04">日珥，真美啊。\n智慧属于人民！光荣啊，祖国！我们为你骄傲！\n（俄罗斯国歌）</string>
    <string name="BeautifulProminence_Dialog1">长官！我们的EMP干扰舰船完工了。请您命名！</string>
    <string name="BeautifulProminence_NameOption">“万年风雪号”</string>
    <string name="BeautifulProminence_Dialog2">确实是很美的名字，不过这个名字有什么含义？</string>
    <string name="BeautifulProminence_HistoryOption">只是一段历史</string>
    <string name="BeautifulProminence_Dialog3">致万年的风霜与飞雪。</string>
    <string name="BeautifulProminence_SaluteOption">致屹立于风雪之人</string>
    <string name="ConfidentialFile2001">2001机密文件</string>
    <string name="StarshipEarthExperimentalPlatform">星舰地球实验装置平台</string>
    <string name="StarshipEarthExperimentalPlatformDescription">为大型旗舰设计的模块化伴飞平台，可搭载特种实验装置并随舰部署。</string>
    <string name="TrisolarisCruiser">阿尔法</string>
    <string name="TrisolarisCruiserDescription">三体舰队的高速主力巡洋舰，可使用不同武器改型投入战斗。</string>
    <string name="TrisolarisBattleship">贝塔</string>
    <string name="TrisolarisBattleshipDescription">装备强相互作用力装甲与反物质武器的三体重型战舰。</string>
    <string name="TrisolarisFlagship">伽马</string>
    <string name="TrisolarisFlagshipDescription">三体舰队的核心旗舰，拥有多套高威胁默认配装。</string>
    <string name="TrisolarisTitan">朝歌</string>
    <string name="TrisolarisTitanDescription">三体舰队的泰坦级主力舰，搭载大型武器阵列与高密度能源系统。</string>
    <string name="TrisolarisAntimatterEngine">先进反物质引擎</string>
    <string name="TrisolarisAntimatterEngineDescription">以反物质湮灭产物直接驱动的先进推进装置，拥有卓越的加速与转向能力。</string>
    <string name="TrisolarisFleetEngine">舰队引擎</string>
    <string name="TrisolarisFleetEngineDescription">为三体主力舰队设计的重型推进阵列，可同时提供极高直线推力与姿态控制能力。</string>
    <string name="TrisolarisSuperEngine">三体超级引擎</string>
    <string name="TrisolarisSuperEngineDescription">将舰队级推进阵列与曲率技术融为一体的超级引擎，具备跨越星海的强大推进能力。</string>
    <string name="TrisolarisAntigravityCore">反重力核心</string>
    <string name="TrisolarisAntigravityCoreDescription">通过精密操控局部引力场抵消舰体质量，使大型舰船也能获得轻盈的运动特性。</string>
    <string name="TrisolarisAntimatterReactor">反物质反应堆</string>
    <string name="TrisolarisAntimatterReactorDescription">以受控正反物质湮灭持续供能的高功率反应堆。</string>
    <string name="TrisolarisSimArmor">强互作用力甲</string>
    <string name="TrisolarisSimArmorDescription">以强互作用力锁定物质结构的致密装甲，能够承受极端战场环境。</string>
    <string name="TrisolarisAntimatterProjector">反物质投射器</string>
    <string name="TrisolarisAntimatterProjectorDescription">投射受控反物质载荷的重型武器，命中后释放毁灭性的能量。</string>
    <string name="TrisolarisAnnihilationRay">湮灭射线</string>
    <string name="TrisolarisAnnihilationRayDescription">将湮灭能量约束为高密度射线，对目标持续造成严重热损伤。</string>
    <string name="TrisolarisAntimatterMissile">反物质导弹</string>
    <string name="TrisolarisAntimatterMissileDescription">搭载磁约束反物质战斗部的远程导弹，具有强大的瞬时毁伤能力。</string>
    <string name="TrisolarisAntimatterBattery">反物质仓库</string>
    <string name="TrisolarisAntimatterBatteryDescription">以多重磁场稳定封存反物质的高密度能源仓，为三体舰船提供庞大能量储备。</string>
    <string name="ThreeBody_StarshipEarth">星舰地球占位科技</string>
    <string name="ThreeBody_Trisolaris">三体占位科技</string>
    <string name="ThreeBody_SecondFleet">第二舰队科技</string>
    <string name="ThreeBody_SecondFleetDescription">完成现有三体科技体系后，通向第二舰队技术路线的预留节点。</string>
    <string name="ThreeBody_Singer">歌者占位科技</string>
    <string name="ThreeBody_Returners">归零者占位科技</string>
    <string name="ThreeBody_RimWorld">边缘世界占位科技</string>
    <string name="ThreeBody_Graveyard">墓地占位科技</string>
    <string name="ThreeBody_FourDimensionalSpace">四维空间占位科技</string>
