    <string name="EmptyDream">空幻之梦</string>
    <string name="EmptyDreamDescription">自由势力旗舰。舰体围绕高维能量骨架构筑，专用于三体模组测试。</string>
    <string name="TearTheStars">撕裂星辰</string>
    <string name="TearTheStarsDescription">发射超远程维度伤害束，无视常规护盾、装甲抗性与减伤。</string>
    <string name="ZeroElementArmor">零素装甲</string>
    <string name="ZeroElementArmorDescription">四格测试装甲，提供极高装甲值、修复能力和全属性减伤。</string>
    <string name="QuantumLoanGenerator">量子借贷发电机</string>
    <string name="QuantumLoanGeneratorDescription">四格测试反应堆，从未来真空中借取近乎无限的能量。</string>
    <string name="FtlDevice">FTL装置</string>
    <string name="FtlDeviceDescription">六格超光速引擎，提供极高推进力和转向速度。</string>
    <string name="ElectronCompressor">电子压缩器</string>
    <string name="ElectronCompressorDescription">测试电池，以压缩电子态存储巨量能量。</string>
    <string name="TrueDamage">维度伤害</string>
    <string name="TrueDPS">维度伤害/秒</string>

    <string name="StarshipEarthLaser">激光</string>
    <string name="StarshipEarthLaserDescription">将高能能量聚合发射出去的标准制式武器</string>
    <string name="StarshipEarthRailgun">电磁炮</string>
    <string name="StarshipEarthRailgunDescription">利用长电磁轨道加速弹丸实现极高的动能打击，可以轻松摧毁一座山</string>
    <string name="NanobladeArmor">飞刃纳米装甲</string>
    <string name="NanobladeArmorDescription">利用高强度纳米材料制成的标准制式装甲</string>
    <string name="StarshipEarthFusionReactor">聚变反应炉</string>
    <string name="StarshipEarthFusionReactorDescription">利用核聚变发电的装置，可以提供能量恢复</string>
    <string name="ReactionlessEngine">无工质引擎</string>
    <string name="ReactionlessEngineDescription">一种无需工质的星际航行引擎，是支持飞船星际航行的基础</string>
    <string name="StarshipEarthWarpDrive">曲速引擎</string>
    <string name="StarshipEarthWarpDriveDescription">光速引擎，通过扭曲空间实现极高速度的航行，但是副作用是使用后留下的航迹会生成有减速作用的黑黑域</string>
    <string name="SuperconductingBattery">超导电池</string>
    <string name="SuperconductingBatteryDescription">一种损耗几乎为0的超导储存能量装置</string>

    <string name="StarshipEarthBallLightning">球状闪电</string>
    <string name="StarshipEarthBallLightningDescription">将宏电子送入战场，受击后释放按受损程度变化的球状闪电。</string>
    <string name="TrisolarisAntimatterCollector">反物质收集器</string>
    <string name="TrisolarisAntimatterCollectorDescription">收集反物质并释放维护机器人，持续修复舰体与能量。</string>

    <string name="StarshipEarthFrigate">追光号</string>
    <string name="StarshipEarthFrigateDescription">星舰地球护卫舰，强调快速部署与低成本远程火力。</string>
    <string name="StarshipEarthDestroyer">蓝色空间号</string>
    <string name="StarshipEarthDestroyerDescription">星舰地球驱逐舰，具备成对武器阵列和稳定的无工质推进能力。</string>
    <string name="StarshipEarthCruiser">终极规律号</string>
    <string name="StarshipEarthCruiserDescription">星舰地球巡洋舰，围绕电磁主炮与高密度能源系统设计。</string>
    <string name="StarshipEarthBattleship">青铜时代号</string>
    <string name="StarshipEarthBattleshipDescription">星舰地球战列舰，可搭载曲速引擎并维持重型远程火力。</string>
    <string name="StarshipEarthFlagship">自然选择号</string>
    <string name="StarshipEarthFlagshipDescription">星舰地球旗舰，能够同时搭载全部星舰地球特色装置。</string>
    <string name="StarshipEarthHeavyRailgun">大型电磁炮</string>
    <string name="StarshipEarthHeavyRailgunDescription">进一步优化了弹丸与加速轨道，提升了更高的伤害与耗能</string>
    <string name="StarshipEarthFocusedLaser">聚能激光</string>
    <string name="StarshipEarthFocusedLaserDescription">进一步优化、强化了高能能量聚合伤害与耗能</string>
    <string name="StarshipEarthAntimatterDrive">反物质引擎</string>
    <string name="StarshipEarthAntimatterDriveDescription">利用正反物质湮灭爆发的巨大能量进行供能驱动的引擎</string>
    <string name="StarshipEarthInterceptorLaser">小型拦截激光</string>
    <string name="StarshipEarthInterceptorLaserDescription">主动拦截防御武器，可以拦截攻击导弹并提前引爆，运气够好可以拦截动能弹药</string>
    <string name="SophonSimPointDefense">SIM弹头近防炮</string>
    <string name="SophonSimPointDefenseDescription">一格L槽自主近防炮，以每秒10发的射速发射SIM实弹，单发造成5点物理伤害并穿透目标80%的动能抗性；360°旋转并始终优先拦截射程内导弹。</string>
    <string name="WeaponTestPlatform">武器测试平台</string>
    <string name="PhotonProjectileLauncher">光粒发射器</string>
    <string name="PhotonProjectileLauncherDescription">歌者文明的高速光粒武器，贯穿航路上的一切目标，并在射程极限释放毁灭性冲击。</string>
    <string name="DualVectorFoilLauncher">二向箔发射器</string>
    <string name="DualVectorFoilLauncherDescription">发射封装二向箔；十五秒后展开，并以不可逆的二维化区域吞没范围内单位。</string>
    <string name="MiniBlackHoleLauncher">小型黑洞发射器</string>
    <string name="MiniBlackHoleLauncherDescription">释放短暂存在的小型黑洞，吞噬射弹、阻断激光并撕裂接触目标。</string>
    <string name="DarkDomainConfinement">黑域禁锢</string>
    <string name="DarkDomainConfinementDescription">命中后制造永久小型黑域，将目标禁锢于低光速区域。</string>
  <string name="LowDimensionalProjectionDevice">低维投影装置</string>
  <string name="LowDimensionalProjectionDeviceDescription">预先创建的低维投影使舰船能在降维后继续战斗</string>
  <string name="EarthTitan">地球泰坦</string>
  <string name="EarthTitanDescription">星舰地球的泰坦级旗舰，兼具重型远程火力、坚固船体与多引擎推进阵列。</string>
  <string name="TrisolaranStarbase">三体空间站</string>
  <string name="TrisolaranStarbaseDescription">三体文明的固定防御空间站，以反物质投射器构成全向火力网。</string>
  <string name="SophonLauncher">智子发射器</string>
  <string name="SophonLauncherDescription">三体巡洋舰。舰首保留为智子发射与导航结构，两侧搭载反物质投射器。</string>
  <string name="IdealBlackbody">理想黑体</string>
  <string name="IdealBlackbodyDescription">以人工黑体场抹除本舰的电磁特征，使其短暂脱离常规雷达的注视。</string>
  <string name="ThreeBodyEmpMissile">EMP弹</string>
  <string name="ThreeBodyEmpMissileDescription">定向电磁脉冲战斗部会在命中瞬间扰乱目标的探测与供能系统。</string>
  <string name="Sophon">智子</string>
  <string name="SophonDescription">将智子投射至战场，使敌方传感网络陷入长期的错误与静默，并揭开一切伪装。</string>
  <string name="StellarHydrogenBomb">恒星级氢弹</string>
  <string name="StellarHydrogenBombDescription">将恒星深处的聚变烈焰束缚于弹头之中；爆炸时湮灭目标区域，并对当前玩家操控舰船以外的全部敌我舰船施加30秒EMP干扰。</string>
  <string name="WanNianFengXue">万年风雪号</string>
  <string name="SHIPBUILD_94009">万年风雪号</string>
  <string name="WanNianFengXueDescription">星舰地球特种驱逐舰。舰首封装沉默核心，不参与常规舰队生成，也不进入商店与科技树。</string>
  <string name="SilentCore">沉默核心</string>
  <string name="SilentCoreDescription">竖向3×5红色S槽专属装置。启动后立即令全场敌我舰船承受60秒EMP；舰体电磁放电在3秒内持续增强，随后以恒星级氢弹的伤害与范围自爆。爆炸不会伤害友军，但载舰必定毁灭。</string>
  <string name="LightSpeedPositronBeam">光速正电子束</string>
  <string name="LightSpeedPositronBeamDescription">将接近光速的正电子流压缩为稳定束流，持续灼穿远方目标的能量防护。</string>
  <string name="Xinghuan">星环号</string>
  <string name="XinghuanDescription">星舰地球的 Titan+ 级旗舰。拥有环形船体、重型能源防御阵列与战略核火力。</string>
    <string name="DeflectionShield">偏转盾</string>
    <string name="DeflectionShieldDescription">利用高曲率场重定向入射光束，使反射火力重新归属本舰。</string>
    <string name="AngelShield">安乐天使</string>
    <string name="AngelShieldDescription">展开封闭的绝对隔离层，短时间切断护盾内外的一切火力交换。</string>
    <string name="SubspaceShield">亚空间盾</string>
    <string name="SubspaceShieldDescription">将舰体压入亚空间夹层，以持续侵蚀结构为代价隔绝常规攻击。</string>
    <string name="ElectronicShield">电子护盾</string>
    <string name="ElectronicShieldDescription">以强制接管协议重写来袭导弹与无人机的敌我识别。</string>
    <string name="SingerCruiser">舞曲</string>
    <string name="SingerCruiserDescription">歌者文明的巡弋清理舰。纤长舰首封装“针”，舰体内由高度集成的能源、装甲与推进系统维持远距离猎杀能力。</string>
    <string name="SingerBattleship">颂歌</string>
    <string name="SingerBattleshipDescription">歌者文明的重型清理战舰。舰首搭载光粒发射器，以庞大的真空能源阵列、活性装甲和曲率推进系统支撑跨星系作战。</string>
    <string name="SingerFlagship">史诗</string>
    <string name="SingerFlagshipDescription">歌者文明的旗舰级清理舰。舰首光粒负责正面毁灭，两侧的“针”沿平行航线贯穿敌阵，构成无可规避的清理齐射。</string>
    <string name="SingerNeedle">针</string>
    <string name="SingerNeedleDescription">将极细的实体贯穿体加速至近乎无法观测的速度，沿射线连续穿透航路上的敌舰。</string>
    <string name="SingerEngine">歌者曲率引擎</string>
    <string name="SingerEngineDescription">以精密曲率梯度牵引舰体前行，几乎不留下可供低等文明追踪的推进痕迹。</string>
    <string name="SingerReactor">歌者真空能源核心</string>
    <string name="SingerReactorDescription">从真空涨落中抽取稳定能量，为歌者舰船的清理武器与航行系统持续供能。</string>
    <string name="SingerArmor">歌者自洽装甲</string>
    <string name="SingerArmorDescription">由自洽结构层层锁合而成的舰体防护，能够将外来扰动分散到整个装甲网络。</string>
    <string name="SingerBattery">静滞能量仓</string>
    <string name="SingerBatteryDescription">以静滞场将庞大能量封存在彼此隔绝的单元中，为歌者舰船提供近乎无损的高密度储能。</string>
    <string name="SingerTitan">挽歌</string>
    <string name="SingerTitanDescription">歌者文明的泰坦级清理舰，以二向箔构筑降维封锁，并由光粒与针封死所有逃逸航线。</string>
    <string name="SingerStarbase">歌者空间站</string>
    <string name="SingerStarbaseDescription">歌者文明的固定清理枢纽，以交错的光粒和针构成覆盖所有方向的毁灭火网。</string>
    <string name="TrisolarisExperimentalPlatform">三体实验装置平台</string>
    <string name="SingerExperimentalPlatform">歌者实验装置平台</string>
    <string name="FringeExperimentalPlatform">边缘世界实验装置平台</string>
    <string name="SmallUniverseEntrance">小宇宙入口</string>
    <string name="SmallUniverseEntranceDescription">开启与大宇宙隔绝的封闭时空。短暂触碰可将周围单位放逐，持续开启则可让载舰避入其中完成修复，并从远离敌阵的位置重返战场。</string>
    <string name="TimeRiftGenerator">时空裂隙发生器</string>
    <string name="TimeRiftGeneratorDescription">在战场各处撕开分叉的时空裂隙。闯入裂隙的敌舰会遭到结构剥离，被抛往未知坐标，并失去全部装置的准备进度。</string>
    <string name="EdgeEngine">边缘世界矢量引擎</string>
    <string name="EdgeEngineDescription">以暴露式桁架承载高功率推进阵列，在极端工况下仍能保持可靠的推力与转向响应。</string>
    <string name="EdgeReactor">边缘世界裂变反应堆</string>
    <string name="EdgeReactorDescription">模块化能量核心将多个反应单元并联运行，为无人系统和电子战设备持续供能。</string>
    <string name="EdgeArmor">边缘世界工业装甲</string>
    <string name="EdgeArmorDescription">由重型白灰复合板、黑色承力骨架和自检节点组成的高强度舰体防护。</string>
    <string name="EdgeBattery">边缘世界脉冲电池</string>
    <string name="EdgeBatteryDescription">将高密度能源封装在独立隔舱中，专为高峰值电子战负载提供稳定储能。</string>
    <string name="EdgeDroneCannon">无人机脉冲炮</string>
    <string name="EdgeDroneCannonDescription">为边缘世界无人机定制的紧凑型能量武器，能够持续压制轻型目标。</string>
    <string name="EdgeDefenseLaser">防卫拦截激光</string>
    <string name="EdgeDefenseLaserDescription">防卫无人机专用的自主激光阵列，优先烧蚀来袭弹体；近防火力来不及阻止威胁时，无人机会主动撞击拦截。</string>
    <string name="EdgeDroneEngine">无人机矢量引擎</string>
    <string name="EdgeDroneEngineDescription">高响应微型推进阵列，使无人机能够快速改变航向并贴近目标。</string>
    <string name="EdgeDroneArmor">无人机工业装甲</string>
    <string name="EdgeDroneArmorDescription">围绕核心节点布置的轻量复合护板，兼顾生存能力与机动效率。</string>
    <string name="EdgeDroneReactor">无人机微型反应堆</string>
    <string name="EdgeDroneReactorDescription">为自治作战单元提供持续能源的高密度微型核心。</string>
    <string name="EdgeEmpLaser">EMP激光</string>
    <string name="EdgeEmpLaserDescription">将破坏性电磁调制叠加在连续光束中，使受照目标的雷达与控制网络陷入混乱。</string>
    <string name="EdgeNanoTorpedo">纳米鱼雷</string>
    <string name="EdgeNanoTorpedoDescription">命中后释放自组织纳米集群，利用从目标剥离的物质现场构筑友方无人机。</string>
    <string name="EdgePredatorSwarm">掠食者集群</string>
    <string name="EdgePredatorSwarmDescription">投送封装的掠食者无人机群，在抵达目标或航程终点时解除约束并展开猎杀。</string>
    <string name="EdgeVirusCode">病毒代码</string>
    <string name="EdgeVirusCodeDescription">向敌舰写入伪造的敌我识别协议，使其暂时接受边缘世界的战术指令。</string>
    <string name="EdgeNanoStorm">纳米风暴</string>
    <string name="EdgeNanoStormDescription">一次性释放规模庞大的掠食者集群，以自治猎杀节点淹没整片战区。</string>
    <string name="EdgeFirewallCollapse">防火墙崩溃</string>
    <string name="EdgeFirewallCollapseDescription">瓦解敌军之间的身份认证与协同协议，迫使其武器系统互相视作敌对目标。</string>
    <string name="EdgeDroneCommand">边缘世界指挥中枢</string>
    <string name="EdgeDroneCommandDescription">统一处理无人机导航、火控、防御、补充与通信，整合大型无人机强化系统的全部能力。</string>
    <string name="EdgeDroneHive">无人机母巢</string>
    <string name="EdgeDroneHiveDescription">持续制造并放出边缘世界无人机，以不断补充的自治单元维持战场压力。</string>
    <string name="EdgeDefender">捍卫者</string>
    <string name="EdgeDefenderDescription">部署一架贴身防卫无人机，主动撞截导弹、射弹与无法被常规近防火力处理的攻击。</string>
    <string name="SingerStasisBeam">静滞光束</string>
    <string name="SingerStasisBeamDescription">将命中目标锁入迟滞场。舰船与无人机行动骤缓，飞行武器则在静止中耗尽剩余航程。</string>
    <string name="EdgeDrone">边缘世界无人机</string>
    <string name="EdgePredatorDrone">掠食无人机</string>
    <string name="EdgeDefenseDrone">防卫无人机</string>
    <string name="EdgeStack">堆栈</string>
    <string name="EdgeRecursive">递归</string>
    <string name="EdgeTerminateProcess">终止进程</string>
    <string name="EdgeHighestPrivilege">最高权限</string>
    <string name="EdgeCentralProcessor">中央处理器</string>
</resources>
