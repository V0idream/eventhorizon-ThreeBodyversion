    <string name="StarshipEarthExperimentalPlatform">实验性装备搭载平台</string>
    <string name="StarshipEarthExperimentalPlatformDescription">为大型旗舰设计的模块化伴飞平台，可搭载特种实验装置并随舰部署。</string>
    <string name="TrisolarisCruiser">三体巡洋舰</string>
    <string name="TrisolarisCruiserDescription">三体舰队的高速主力巡洋舰，可使用不同武器改型投入战斗。</string>
    <string name="TrisolarisBattleship">三体战舰</string>
    <string name="TrisolarisBattleshipDescription">装备强相互作用力装甲与反物质武器的三体重型战舰。</string>
    <string name="TrisolarisFlagship">三体旗舰</string>
    <string name="TrisolarisFlagshipDescription">三体舰队的核心旗舰，拥有多套高威胁默认配装。</string>
    <string name="TrisolarisAntimatterEngine">先进反物质引擎</string>
    <string name="TrisolarisAntimatterEngineDescription">以反物质湮灭产物直接驱动的先进推进装置，拥有卓越的加速与转向能力。</string>
    <string name="TrisolarisFleetEngine">舰队引擎</string>
    <string name="TrisolarisFleetEngineDescription">为三体主力舰队设计的重型推进阵列，可同时提供极高直线推力与姿态控制能力。</string>
    <string name="TrisolarisAntimatterReactor">反物质反应堆</string>
    <string name="TrisolarisAntimatterReactorDescription">以受控正反物质湮灭持续供能的高功率反应堆。</string>
    <string name="TrisolarisSimArmor">强互作用力甲</string>
    <string name="TrisolarisSimArmorDescription">以强互作用力锁定物质结构的致密装甲，能够承受极端战场环境。</string>
    <string name="TrisolarisAntimatterProjector">反物质投射器</string>
    <string name="TrisolarisAntimatterProjectorDescription">投射受控反物质载荷的重型武器，命中后释放毁灭性的能量。</string>
    <string name="TrisolarisAnnihilationRay">湮灭射线</string>
    <string name="TrisolarisAnnihilationRayDescription">将湮灭能量约束为高密度射线，对目标持续造成严重热损伤。</string>
    <string name="TrisolarisAntimatterMissile">反物质导弹</string>
    <string name="TrisolarisAntimatterMissileDescription">搭载磁约束反物质战斗部的远程导弹，具有强大的瞬时毁伤能力。</string>
    <string name="TrisolarisAntimatterBattery">反物质仓库</string>
    <string name="TrisolarisAntimatterBatteryDescription">以多重磁场稳定封存反物质的高密度能源仓，为三体舰船提供庞大能量储备。</string>
